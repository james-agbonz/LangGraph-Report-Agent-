# Copy to .env and pick one provider. Never commit .env.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3.5:0.8b
# NVIDIA NIM:  LLM_BASE_URL=https://integrate.api.nvidia.com/v1   LLM_API_KEY=nvapi-...   LLM_MODEL=openai/gpt-oss-20b
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_API_KEY=...   LLM_MODEL=gemini-2.5-flash
# No model:    LLM_PROVIDER=fake

# Gmail (optional; run with: python -m app.gmail)
GMAIL_LABEL=reports
GMAIL_SEND=false
LEADERSHIP_EMAIL=
POLL_SECONDS=60
